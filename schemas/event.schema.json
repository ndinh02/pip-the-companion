{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndinh02/pippi-the-companion/schemas/event.schema.json",
  "title": "event",
  "description": "One SPADL-like on-ball action from match-lab (draft v0, brief 8.2). Coordinates in metres on a 105 x 68 pitch, origin bottom-left. Players are placeholders such as HAR-7.",
  "type": "object",
  "required": [
    "event_id", "idx", "period", "t_ms", "clock_display", "team_id", "player_id",
    "type", "subtype", "start", "end", "outcome", "possession_id", "pressure_level", "set_piece"
  ],
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 105 },
        "y": { "type": "number", "minimum": 0, "maximum": 68 }
      }
    },
    "setPiece": {
      "type": "object",
      "required": ["routine", "delivery", "target_zone"],
      "additionalProperties": false,
      "properties": {
        "routine": { "enum": ["short", "cross", "shoot"] },
        "delivery": { "enum": ["inswing", "outswing", null] },
        "target_zone": { "enum": ["short", "near", "central", "far", "goal"] }
      }
    }
  },
  "properties": {
    "event_id": { "type": "string", "pattern": "^e[0-9]{5,}$" },
    "idx": { "type": "integer", "minimum": 0 },
    "period": { "enum": [1, 2] },
    "t_ms": { "type": "integer", "minimum": 0 },
    "clock_display": { "type": "string", "pattern": "^[0-9]{1,3}(\\+[0-9]{1,2})?:[0-9]{2}$" },
    "team_id": { "type": "string", "pattern": "^[A-Z]{2,4}$" },
    "player_id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{1,2}$" },
    "player_out_id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{1,2}$" },
    "type": {
      "enum": [
        "pass", "dribble", "cross", "shot", "tackle", "interception", "clearance", "foul", "card",
        "keeper_save", "goal_kick", "throw_in", "corner", "free_kick", "substitution"
      ]
    },
    "subtype": { "type": ["string", "null"] },
    "start": { "$ref": "#/$defs/point" },
    "end": { "$ref": "#/$defs/point" },
    "outcome": { "enum": ["success", "fail", "goal", "saved", "blocked", "off_target", "disallowed", "foul"] },
    "possession_id": { "type": "integer", "minimum": 0 },
    "pressure_level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "set_piece": {
      "description": "Only set on corners and free kicks; null otherwise.",
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/setPiece" }]
    }
  }
}
