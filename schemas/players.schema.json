{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ndinh02/pippi-the-companion/schemas/players.schema.json",
  "title": "players",
  "description": "Per-player cumulative stats by match minute (task 05). array[m] = value at the start of minute m: counted stats from the tracked events, physical stats from the 5 Hz synthetic tracking. Cards identify players by team + number + position only (scope decision D1: no names).",
  "type": "object",
  "required": ["match_id", "seed", "reader_version", "last_minute", "model", "players"],
  "additionalProperties": false,
  "$defs": {
    "series": {
      "type": "array",
      "minItems": 91,
      "items": { "type": "integer", "minimum": 0 }
    }
  },
  "properties": {
    "match_id": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "reader_version": { "type": "string", "minLength": 1 },
    "last_minute": { "type": "integer", "minimum": 90 },
    "model": { "type": "string", "minLength": 1 },
    "players": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "required": ["player_id", "team_id", "shirt_no", "position", "on_min", "off_min", "stats"],
        "additionalProperties": false,
        "properties": {
          "player_id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{1,2}$" },
          "team_id": { "enum": ["HAR", "COP"] },
          "shirt_no": { "type": "integer", "minimum": 1, "maximum": 14 },
          "position": { "enum": ["GK", "DF", "MF", "FW"] },
          "on_min": { "type": "number", "minimum": 0 },
          "off_min": { "anyOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] },
          "stats": {
            "type": "object",
            "required": ["passes", "passes_ok", "hard_ok", "ball_wins", "shots", "saves",
                         "distance_m", "top_speed_dmh", "sprints"],
            "additionalProperties": false,
            "properties": {
              "passes": { "$ref": "#/$defs/series" },
              "passes_ok": { "$ref": "#/$defs/series" },
              "hard_ok": { "$ref": "#/$defs/series" },
              "ball_wins": { "$ref": "#/$defs/series" },
              "shots": { "$ref": "#/$defs/series" },
              "saves": { "$ref": "#/$defs/series" },
              "distance_m": { "$ref": "#/$defs/series" },
              "top_speed_dmh": { "$ref": "#/$defs/series" },
              "sprints": { "$ref": "#/$defs/series" }
            }
          }
        }
      }
    }
  }
}
